local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
pledge("load", `fs:read=$ROOT/*`, "network:udp")
package.path = `$ROOT/?.lus;$(package.path)`

local cron = require("cron")

-- Returns the next `count` matches after the ISO time `after`, joined by spaces.
local function run(expression, after, zone, count)
    local t = time.parse(after)
    local out = {}
    for _ = 1, count do
        t = cron.next(expression, t, zone)
        if t == nil then
            out[#out + 1] = "nil"
            break
        end
        out[#out + 1] = t:iso()
    end
    return table.concat(out, " ")
end

local next_cases = {
    every_minute = { "* * * * *", "2026-01-01T00:00:30Z", false, "2026-01-01T00:01:00Z 2026-01-01T00:02:00Z" },
